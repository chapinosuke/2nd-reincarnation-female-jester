---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '異世界転生コメディ・連載中' } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfaf4" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Zen+Old+Mincho:wght@500;600;700;900&family=Noto+Serif+JP:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="font-serif">
    <slot />
    <footer class="border-t border-gilt-400/30 py-10 text-center">
      <p class="font-eyebrow text-[11px] tracking-[0.3em] text-tide-600">
        © {new Date().getFullYear()} 2度目の転生は女遊び人でした
      </p>
    </footer>
  </body>
</html>
