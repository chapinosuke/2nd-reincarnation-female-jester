---
import '../styles/global.css';
import '../styles/pop.css';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_AUTHOR } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}

const base = import.meta.env.BASE_URL;

const {
  title,
  description = '異世界転生コメディ・連載中',
  ogImage = `${base}ogp.jpg`,
  ogType = 'website',
  structuredData,
  bodyClass = '',
} = Astro.props;

const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.toString();
const absoluteOgImage = Astro.site ? new URL(ogImage, Astro.site).toString() : ogImage;

const isTeaser = bodyClass.includes('teaser-page');
const isReader = bodyClass.includes('reader-page');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fffaf3" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={`${base}sitemap.xml`} />
    <link rel="alternate" type="application/rss+xml" title="更新情報" href={`${base}rss.xml`} />
    <meta name="author" content={SITE_AUTHOR} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="2度目の転生は女遊び人でした" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700;900&family=Noto+Serif+JP:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    <!-- FOUC防止：保存済みの文字サイズ設定を描画前に適用する -->
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem('reader-font-size');
          if (s === 's' || s === 'm' || s === 'l') {
            document.documentElement.setAttribute('data-font-size', s);
          }
          var t = localStorage.getItem('reader-theme');
          if (t === 'paper' || t === 'white' || t === 'night') {
            document.documentElement.setAttribute('data-reader-theme', t);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body id="site-top" class:list={[!isTeaser && 'pop-page', bodyClass]}>
    {!isTeaser && <a class="pop-skip" href={isReader ? '#reader-article' : '#page-content'}>本文へスキップ</a>}
    <slot />
    {!isTeaser && <SiteFooter />}
  </body>
</html>
