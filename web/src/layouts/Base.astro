---
import '../styles/global.css';
import { SITE_AUTHOR } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}

const base = import.meta.env.BASE_URL;

const {
  title,
  description = '異世界転生コメディ・連載中',
  ogImage = `${base}ogp.png`,
  ogType = 'website',
  structuredData,
  bodyClass = '',
} = Astro.props;

const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.toString();
const absoluteOgImage = Astro.site ? new URL(ogImage, Astro.site).toString() : ogImage;

const navLinks = [
  { href: base, label: 'もくじ' },
  { href: `${base}news`, label: '更新' },
  { href: `${base}characters`, label: '人物' },
  { href: `${base}world`, label: '世界観' },
  { href: `${base}ledger`, label: '帳簿' },
  { href: `${base}gallery`, label: '画廊' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfaf4" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={`${base}sitemap.xml`} />
    <link rel="alternate" type="application/rss+xml" title="更新情報" href={`${base}rss.xml`} />
    <meta name="author" content={SITE_AUTHOR} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="2度目の転生は女遊び人でした" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Zen+Old+Mincho:wght@500;600;700;900&family=Noto+Serif+JP:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    <!-- FOUC防止：保存済みの文字サイズ設定を描画前に適用する -->
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem('reader-font-size');
          if (s === 's' || s === 'm' || s === 'l') {
            document.documentElement.setAttribute('data-font-size', s);
          }
          var t = localStorage.getItem('reader-theme');
          if (t === 'paper' || t === 'white' || t === 'night') {
            document.documentElement.setAttribute('data-reader-theme', t);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class:list={['font-serif', bodyClass]}>
    <slot />
    <footer class="relative isolate overflow-hidden text-center">
      <!-- 背景：ハイベルの街の水彩画。上端は紙色へフェードさせ本文と地続きにする -->
      <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
        <div
          class="absolute inset-0 bg-cover bg-bottom opacity-90"
          style={`background-image:url('${base}footer-town.webp')`}
        >
        </div>
        <!-- 上部フェード：丘の上の城より上の空だけ紙色へ短く溶かす（目次との余白を詰める） -->
        <div
          class="absolute inset-0"
          style="background:linear-gradient(to bottom,#fbfaf4 0%,rgba(251,250,244,0.85) 6%,rgba(251,250,244,0.25) 14%,rgba(251,250,244,0) 22%)"
        >
        </div>
        <!-- 下部：ナビ・著作権の可読性を保つ淡い紙のスクリム -->
        <div
          class="absolute inset-x-0 bottom-0 h-40"
          style="background:linear-gradient(to top,rgba(251,250,244,0.94) 0%,rgba(251,250,244,0.7) 45%,rgba(251,250,244,0) 100%)"
        >
        </div>
      </div>

      <div class="relative px-4 pb-9 pt-[clamp(14rem,34vw,34rem)]">
        <nav class="mb-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
          {
            navLinks.map((link, i) => (
              <>
                {i > 0 && (
                  <span class="text-ink-500" aria-hidden="true">
                    ・
                  </span>
                )}
                <a
                  href={link.href}
                  class="text-xs tracking-[0.2em] text-tide-700 transition hover:text-gilt-600"
                >
                  {link.label}
                </a>
              </>
            ))
          }
        </nav>
        <p class="mb-2 text-[11px] tracking-[0.14em] text-ink-500">
          ハイベルの酒場と、ギルドの台帳と
        </p>
        <p class="font-eyebrow text-[11px] tracking-[0.3em] text-tide-600">
          © {new Date().getFullYear()} {SITE_AUTHOR} / 2度目の転生は女遊び人でした
        </p>
      </div>
    </footer>
  </body>
</html>
