---
import Base from '../layouts/Base.astro';
import TeaserNav from '../components/TeaserNav.astro';
import TitleLogo from '../components/TitleLogo.astro';
import CharacterPortrait from '../components/CharacterPortrait.astro';
import '../styles/teaser.css';
import { getChapters, groupByArc, toKanji, stripChapterPrefix } from '../lib/chapters';
import { displayDate, NEWS, SITE_AUTHOR, SITE_DESCRIPTION } from '../lib/site';

const chapters = await getChapters();
const first = chapters[0];
const latest = chapters.at(-1);
const arcs = groupByArc(chapters);
const base = import.meta.env.BASE_URL;
const coverSrc = `${base}cover.png`;
const heroSrc = `${base}generated/party-cute-teaser-v2.webp`;
const standeeBase = `${base}characters/standees/`;
const party = [
  { id: 'mia', name: 'ミア', en: 'MIA', role: '遊び人 ／ 賢者を目指す転生者', quote: '後ろ、取られてますよ', quip: '戦えないけど、がんばります！', bio: '目が覚めたら「ミア」だった。戦えない。魔法も使えない。装備はバニーガール衣装のみ。それでも酒場では、機転と接客で場の空気を動かしてしまう。心の声はなぜか「オレ」。目指すは、いつか賢者になること。', stamp: '装備は、これだけ。' },
  { id: 'alto', name: 'アルト', en: 'ALTO', role: '勇者（自称） ／ 慎重すぎる青年', quote: '誰か得意な人がやれば……', quip: '本当に、僕がやるんですか？', bio: '勇者は名乗れば誰でもなれる世界なので、名乗ってしまった。気弱で慎重、剣を抜くより謝る方が得意。実家は食堂で、旅先の料理はおまかせ。剣より包丁の方が、よほど手に馴染むらしい。', stamp: '勇者、募集中では？' },
  { id: 'sera', name: 'セラ', en: 'SERA', role: '僧侶 ／ 元・金貸しの娘', quote: '育ちがいいからね', quip: 'その治療、有料です。', bio: '三歳で算盤、五歳で帳簿、七歳で取り立て。回復魔法も「コストのかかる労働」、赤字の依頼は原則お断り。損得で語るくせに、選ぶ答えはいつも誰も潰さない。パーティーの財布と秩序を握る人。', stamp: 'きっちり、記録します。' },
  { id: 'gold', name: 'ゴルド', en: 'GOLD', role: '魔法使い ／ 元・武闘家', quote: '年寄り扱いせんかい！', quip: '殴った方が、早い！', bio: '魔法を唱えるより殴った方が早い、武闘派の魔法使い。酒好きで、財布はよく失くす。魔王討伐の武勇伝は、語るたび細部が変わる。それでも戦場では、なぜか誰より仲間の位置を見ている。', stamp: '魔法使いです。一応。' },
];
const homeUrl = Astro.site ? new URL(base, Astro.site).toString() : base;
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '2度目の転生は女遊び人でした',
  url: homeUrl,
  description: SITE_DESCRIPTION,
  inLanguage: 'ja',
  author: { '@type': 'Person', name: SITE_AUTHOR },
};
---

<Base
  title="2度目の転生は女遊び人でした"
  description={SITE_DESCRIPTION}
  structuredData={websiteSchema}
  bodyClass="teaser-page"
>
  <a class="teaser-skip" href="#main">本文へスキップ</a>
  <TeaserNav />
  <main id="main" class="cute-page">
    <section id="top" class="cute-hero" aria-labelledby="teaser-title">
      <div class="cute-keyvisual">
        <img class="cute-key-art" src={heroSrc} alt="ミアを中心に、気弱なアルト、しっかり者のセラ、豪快なゴルドが集まるキービジュアル" width="1536" height="1024" fetchpriority="high" />
        <p class="cute-catch">人生、二度目も<br /><span>想定外っ！</span></p>
        <p class="cute-hero-bubble">職業：遊び人<br /><strong>装備、これだけ!?</strong></p>
        <div class="cute-title-wrap"><h1 id="teaser-title" class="cute-title"><TitleLogo eager /></h1><p>最弱装備の、異世界お色気コメディ</p></div>
        <span class="cute-spark spark-left" aria-hidden="true">✦</span><span class="cute-spark spark-right" aria-hidden="true">✧</span>
      </div>
      <div class="cute-announcement"><p>WEB小説・第1巻</p><strong>全<span>{chapters.length}話</span>、公開中っ！</strong></div>
      <a class="cute-scroll" href="#news">つづきを見る<span aria-hidden="true">↓</span></a>
    </section>

    <section id="news" class="cute-news cute-section" aria-labelledby="news-heading">
      <header class="cute-heading"><p>NEWS</p><h2 id="news-heading">おしらせ</h2></header>
      <div class="cute-news-paper">{NEWS.slice(0, 2).map(item => <details><summary><time datetime={item.date}>{displayDate(item.date)}</time><span>{item.title}</span><b aria-hidden="true">＋</b></summary><p>{item.body}</p></details>)}<a class="cute-inline-link" href={`${base}news`}>おしらせ一覧へ <span aria-hidden="true">→</span></a></div>
    </section>

    <section id="introduction" class="cute-intro cute-section" aria-labelledby="intro-heading">
      <header class="cute-heading"><p>INTRODUCTION</p><h2 id="intro-heading">二度目の人生へ、ようこそっ。</h2></header>
      <div class="cute-intro-paper"><p>今度こそ、まともな人生！<small>……のはずが、</small></p><h3>職業、<span>女遊び人!?</span></h3><div class="cute-intro-lines"><p>戦えない。魔法も使えない。<br />装備は、バニーガール衣装のみ。<br />二度目の異世界生活、前途多難すぎる。</p><p>酒場『陽気な冒険者』で出会ったのは、<br />気弱な勇者、損得勘定の僧侶、<br />そして、殴る魔法使い。</p><p>ちぐはぐな仲間と、世知辛い毎日。<br /><strong>最弱の職業から、賢者を目指しますっ！</strong></p></div><a class="cute-inline-link" href={`${base}story`}>物語をもっと知る →</a><span class="cute-sticker">異世界 × お仕事<br /><b>ときどき、冒険。</b></span></div>
      <div class="cute-intro-face face-alto" aria-hidden="true"><div class="intro-portrait"><CharacterPortrait character="alto" /></div><span>誰か得意な人が……</span></div>
      <div class="cute-intro-face face-sera" aria-hidden="true"><div class="intro-portrait"><CharacterPortrait character="sera" /></div><span>赤字は、お断り。</span></div>
    </section>

    <section id="characters" class="cute-characters cute-section" aria-labelledby="characters-heading">
      <header class="cute-heading"><p>CHARACTERS</p><h2 id="characters-heading">このパーティー、クセが強い。</h2></header>
      <div class="cute-cast-browser" data-cast-browser>
        <div class="cute-cast-tabs" role="tablist" aria-label="キャラクターを選ぶ" hidden>{party.map((c, i) => <button id={`tab-${c.id}`} type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`panel-${c.id}`} tabindex={i === 0 ? 0 : -1} data-cast-tab><span class={`cute-tab-face cast-${c.id}`}><CharacterPortrait character={c.id} /></span><strong>{c.name}</strong></button>)}</div>
        <div class="cute-cast-stage">{party.map((c) => <article id={`panel-${c.id}`} class={`cute-cast-panel cast-${c.id}`} aria-labelledby={`cast-name-${c.id}`} data-cast-panel>
          <div class="cute-cast-art"><p>{c.quip}</p><div class="cute-cast-cutout"><img src={`${standeeBase}${c.id}-v1.webp`} alt={`${c.name}の立ち絵`} width="1024" height="1536" loading="lazy" /></div></div>
          <div class="cute-cast-copy"><p class="cute-cast-role">{c.role}</p><h3 id={`cast-name-${c.id}`}>{c.name}</h3><p class="cute-cast-roman">{c.en}</p><blockquote>「{c.quote}」</blockquote><p class="cute-cast-bio">{c.bio}</p><p class="cute-cast-stamp">{c.stamp}</p><a class="cute-inline-link" href={`${base}characters#${c.id}`}>もっと知る →</a></div>
        </article>)}</div>
        <div class="cute-cast-controls" hidden><button type="button" data-cast-prev aria-label="前のキャラクター">←</button><span data-cast-count aria-live="polite" aria-atomic="true">ミア / 01</span><button type="button" data-cast-next aria-label="次のキャラクター">→</button></div>
      </div>
      <p class="cute-cast-note">強さだけじゃ、冒険はできない。<br /><span>酒場『陽気な冒険者』の常連たち</span></p>
    </section>

    <section id="movie" class="cute-movie cute-section" aria-labelledby="movie-heading">
      <header class="cute-heading"><p>MOVIE</p><h2 id="movie-heading">動くミアたち、のぞいてみる？</h2></header>
      <figure class="cute-movie-frame">
        <video controls playsinline preload="none" poster={`${base}hero-poster.webp`} width="1280" height="720" aria-label="ハイベルの日常">
          <source src={`${base}hero-bg.mp4`} type="video/mp4" />
          <a href={`${base}hero-bg.mp4`}>動画を開く</a>
        </video>
        <figcaption class="cute-movie-caption">
          <span>ハイベルの日常<small>約30秒・音声なし</small></span>
          <a href={`${base}movie`}>ほかの映像も見る <span aria-hidden="true">↗</span></a>
        </figcaption>
      </figure>
    </section>

    <section id="novel" class="cute-novel cute-section" aria-labelledby="novel-heading">
      <header class="cute-heading"><p>ORIGINAL NOVEL</p><h2 id="novel-heading">冒険の続きは、こちらから。</h2></header>
      <div class="cute-novel-paper"><picture><source srcset={`${base}cover.avif`} type="image/avif" /><img src={coverSrc} alt="WEB小説第1巻表紙" width="600" height="600" loading="lazy" /></picture><div><p class="cute-novel-label">第1巻・全{chapters.length}話</p><h3>最弱の遊び人が、<br />「賢者」を目指すまで。</h3><p>原作・執筆：{SITE_AUTHOR}</p><div class="cute-novel-actions">{first && <a id="start-reading" class="cute-button" href={`${base}chapter/${first.slug}`}>第一話から読む <span aria-hidden="true">→</span></a>}<a id="continue-reading" class="cute-button" href={base} hidden>つづきから読む <span aria-hidden="true">→</span></a>{latest && <a class="cute-inline-link" href={`${base}chapter/${latest.slug}`}>最新話を読む →</a>}</div></div></div>
    </section>

  <!-- CHAPTERS：章（アーク）ごとに畳めるもくじ -->
  <section id="chapters" class="mx-auto max-w-3xl scroll-mt-8 px-6 pb-20 pt-16 md:pb-24 md:pt-24">
    <div class="flex items-center gap-5">
      <div class="tide-rule h-px flex-1 opacity-40" aria-hidden="true"></div>
      <h2 class="font-eyebrow text-sm tracking-[0.5em] text-gilt-600">CONTENTS</h2>
      <div class="tide-rule h-px flex-1 opacity-40" aria-hidden="true"></div>
    </div>
    <p class="mt-2 text-center text-xs tracking-[0.3em] text-ink-600">もくじ</p>
    <p class="mt-2 text-center text-[11px] tracking-[0.12em] text-ink-600">
      ――灰鷲ギルド　ハイベル支部　掲示板より
    </p>

    <div class="mt-10 space-y-4">
      {arcs.map((group, gi) => (
        <details
          class="arc"
          data-from={group.arc.from}
          data-to={group.arc.to}
          open={gi === 0}
        >
          <summary class="sheet sheet-lift flex cursor-pointer items-center gap-4 px-5 py-4 hover:-translate-y-0.5">
            <span class="hanko stamp-in shrink-0 text-[10px]" aria-hidden="true">
              {`${group.arc.no}之章`}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block truncate font-display text-lg text-tide-900 md:text-xl">
                {group.arc.title}
              </span>
              <span class="mt-0.5 block text-xs text-ink-600">
                {`第${toKanji(group.items[0].number)}〜${toKanji(group.items[group.items.length - 1].number)}話`}
              </span>
            </span>
            <span class="arc-marker shrink-0 font-eyebrow text-sm text-tide-500" aria-hidden="true">▽</span>
          </summary>

          <ol class="mt-1 pl-1">
            {group.items.map((c, ci) => (
              <li class="border-b border-gilt-400/15 last:border-b-0">
                <a
                  href={`${base}chapter/${c.slug}`}
                  data-chapter-link={c.slug}
                  class="group flex items-center gap-4 py-3 transition duration-200"
                >
                  <span
                    class="hanko stamp-in shrink-0 text-[10px]"
                    style={`animation-delay: ${ci * 70}ms`}
                    aria-hidden="true"
                  >
                    {`第${toKanji(c.number)}話`}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="sr-only">{`第${c.number}話　`}</span>
                    <span class="block truncate font-display text-lg font-medium text-tide-900 transition duration-200 group-hover:text-seal-600 md:text-xl">
                      {stripChapterPrefix(c.titleLine)}
                    </span>
                  </span>
                  <span data-read-badge hidden class="shrink-0 rounded-full bg-tide-500/10 px-2 py-1 text-[11px] tracking-[0.1em] text-tide-700">読了</span>
                </a>
              </li>
            ))}
          </ol>
        </details>
      ))}
    </div>

    {chapters.length === 0 && (
      <p class="mt-10 text-center font-eyebrow text-sm tracking-widest text-ink-600">
        まだ話がありません。第一話の掲示をお待ちください。
      </p>
    )}
  </section>

  <!-- 読書導線の後に、設定資料への入口を置く -->
  <nav class="mx-auto max-w-3xl px-6 pb-28" aria-label="資料への入口">
    <p class="mb-5 text-center text-xs tracking-[0.2em] text-ink-600">物語の資料</p>
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
      {[
        { href: `${base}characters`, en: 'CHARACTERS', ja: '人物', sub: '常連台帳' },
        { href: `${base}world`, en: 'WORLD', ja: '世界観', sub: '資料室蔵' },
        { href: `${base}ledger`, en: 'LEDGER', ja: '帳簿', sub: '換算と罰金' },
        { href: `${base}gallery`, en: 'GALLERY', ja: '画廊', sub: '一枚絵' },
      ].map((item) => (
        <li>
          <a
            href={item.href}
            class="sheet sheet-lift group flex flex-col items-center gap-0.5 px-3 py-4 text-center hover:-translate-y-0.5"
          >
            <span class="font-eyebrow text-[11px] tracking-[0.3em] text-gilt-600 transition group-hover:text-seal-600">
              {item.en}
            </span>
            <span class="font-display text-base text-tide-900 md:text-lg">{item.ja}</span>
            <span class="mt-0.5 text-[11px] tracking-[0.18em] text-ink-600">{item.sub}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

    <footer class="cute-footer"><a class="cute-back-top" href="#top">↑<span>いちばん上へ</span></a><a class="cute-mini-logo" href="#top"><TitleLogo /></a><p>笑って、働いて、ときどき冒険。</p><small>© {new Date().getFullYear()} {SITE_AUTHOR}</small></footer>
  </main>

  <script>
    const browser = document.querySelector<HTMLElement>('[data-cast-browser]');
    if (browser) {
      const tabs = Array.from(browser.querySelectorAll<HTMLButtonElement>('[data-cast-tab]'));
      const panels = Array.from(browser.querySelectorAll<HTMLElement>('[data-cast-panel]'));
      const count = browser.querySelector<HTMLElement>('[data-cast-count]');
      let selected = 0;
      function selectCharacter(index: number, focus = false) {
        selected = (index + tabs.length) % tabs.length;
        tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === selected)); tab.tabIndex = i === selected ? 0 : -1; });
        panels.forEach((panel, i) => { panel.hidden = i !== selected; panel.setAttribute('role', 'tabpanel'); panel.setAttribute('aria-labelledby', tabs[i].id); panel.tabIndex = 0; });
        if (count) count.textContent = `${tabs[selected].textContent?.trim()} / ${String(selected + 1).padStart(2, '0')}`;
        if (focus) tabs[selected].focus();
      }
      browser.querySelector<HTMLElement>('.cute-cast-tabs')!.hidden = false;
      browser.querySelector<HTMLElement>('.cute-cast-controls')!.hidden = false;
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => selectCharacter(i));
        tab.addEventListener('keydown', event => {
          const next = event.key === 'ArrowRight' ? i + 1 : event.key === 'ArrowLeft' ? i - 1 : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : null;
          if (next !== null) { event.preventDefault(); selectCharacter(next, true); }
        });
      });
      browser.querySelector('[data-cast-prev]')?.addEventListener('click', () => selectCharacter(selected - 1));
      browser.querySelector('[data-cast-next]')?.addEventListener('click', () => selectCharacter(selected + 1));
      selectCharacter(0);
    }
  </script>

  <!-- 「つづきから読む」：last-read がある場合のみ表示 -->
  <script is:inline define:vars={{ base }}>
    (function () {
      try {
        var raw = localStorage.getItem('last-read');
        if (!raw) return;
        var data = JSON.parse(raw);
        if (!data || !data.slug) return;
        var el = document.getElementById('continue-reading');
        if (el) {
          el.setAttribute('href', base + 'chapter/' + data.slug + '?resume=1');
          el.hidden = false;
        }
        var start = document.getElementById('start-reading');
        if (start) start.hidden = true;
        // つづきから読む話を含む章（アーク）も初期状態で開く（先頭章に加えて）
        var num = typeof data.number === 'number' ? data.number : parseInt(data.slug, 10);
        if (!isNaN(num)) {
          var arcs = document.querySelectorAll('#chapters details.arc');
          for (var i = 0; i < arcs.length; i++) {
            var from = parseInt(arcs[i].getAttribute('data-from'), 10);
            var to = parseInt(arcs[i].getAttribute('data-to'), 10);
            if (num >= from && num <= to) {
              arcs[i].open = true;
              break;
            }
          }
        }
      } catch (e) {}
    })();
  </script>

  <script is:inline>
    (function () {
      try {
        var read = JSON.parse(localStorage.getItem('read-chapters') || '[]');
        if (!Array.isArray(read)) return;
        for (var i = 0; i < read.length; i++) {
          var link = document.querySelector('[data-chapter-link="' + read[i] + '"]');
          if (!link) continue;
          var badge = link.querySelector('[data-read-badge]');
          if (badge) badge.hidden = false;
        }
      } catch (e) {}
    })();
  </script>
</Base>
