---
import Base from '../layouts/Base.astro';
import GlobalNav from '../components/GlobalNav.astro';
import { getChapters, groupByArc, toKanji, stripChapterPrefix } from '../lib/chapters';
import { displayDate, NEWS, SITE_AUTHOR, SITE_DESCRIPTION } from '../lib/site';

const chapters = await getChapters();
const first = chapters[0];
const latest = chapters.at(-1);
const arcs = groupByArc(chapters);
const base = import.meta.env.BASE_URL;
const coverSrc = `${base}cover.png`;
const heroSrc = `${base}generated/hero-tavern-v2.webp`;
const homeUrl = Astro.site ? new URL(base, Astro.site).toString() : base;
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '2度目の転生は女遊び人でした',
  url: homeUrl,
  description: SITE_DESCRIPTION,
  inLanguage: 'ja',
  author: { '@type': 'Person', name: SITE_AUTHOR },
};
---

<Base
  title="2度目の転生は女遊び人でした"
  description={SITE_DESCRIPTION}
  structuredData={websiteSchema}
>
  <GlobalNav />
  <!-- HERO：人物資料と同じパーティービジュアルを主役にする -->
  <section class="relative isolate flex min-h-[68svh] items-end overflow-hidden sm:min-h-[76svh] md:min-h-[82svh]">
    <div
      class="pointer-events-none absolute inset-0 z-0 bg-cover bg-[position:72%_center] md:bg-center"
      style={`background-image:url('${base}hero-poster.webp')`}
      aria-hidden="true"
    >
    </div>
    <video
      class="pointer-events-none absolute inset-0 z-0 hidden h-full w-full object-cover md:block motion-reduce:hidden"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={`${base}hero-poster.webp`}
      aria-hidden="true"
    >
      <source src={`${base}hero-bg.mp4`} type="video/mp4" media="(min-width: 768px)" />
    </video>
    <div class="hero-cinematic-wash pointer-events-none absolute inset-0 z-0" aria-hidden="true"></div>
    <div class="hero-dots pointer-events-none absolute inset-0 z-0" aria-hidden="true"></div>
    <div class="tide-rule absolute inset-x-0 top-0 z-10 h-[3px]" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto w-full max-w-6xl px-4 pb-5 pt-20 sm:px-8 sm:pb-8 sm:pt-28 md:pb-14">
      <div class="fade-in max-w-[36rem] rounded-sm border border-gilt-500 bg-paper-50/82 px-5 py-5 shadow-2xl shadow-tide-900/30 ring-1 ring-tide-900/20 backdrop-blur-md sm:px-6 sm:py-7 md:px-9 md:py-9">
        <p class="hero-halo font-eyebrow text-[11px] tracking-[0.32em] text-gilt-600 sm:text-xs">
          ORIGINAL FANTASY PROJECT / WEB NOVEL
        </p>
        <p class="hero-halo mt-1 text-xs tracking-[0.08em] text-seal-600">異世界お色気コメディ・連載中</p>
        <h1
          class="hero-halo mt-3 font-display text-[2rem] font-bold leading-snug text-tide-900 sm:mt-5 sm:text-5xl md:text-6xl"
        >
          2度目の転生は<br />女遊び人でした
        </h1>
        <p class="hero-halo mt-3 max-w-md text-[13px] leading-relaxed text-ink-700 sm:mt-5 sm:text-sm sm:leading-loose md:text-base">
          戦えない。魔法も使えない。装備はバニーガール衣装のみ。<br />
          そんな最底辺から、機転と人心掌握だけで「賢者」を目指す。
        </p>
        <p class="hero-halo mt-3 hidden max-w-md text-xs leading-relaxed tracking-[0.06em] text-tide-700 sm:block md:text-sm">
          灰鷲ギルドの昼の書類から、<br class="sm:hidden" />陽気な冒険者の夜の話を——。
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-2.5 sm:mt-7 sm:gap-3">
          {first && (
            <a
              id="start-reading"
              href={`${base}chapter/${first.slug}`}
              class="inline-flex w-full justify-center rounded-sm bg-seal-500 px-6 py-3 text-sm tracking-[0.08em] text-paper-50 shadow-lg shadow-seal-600/30 ring-1 ring-seal-400/40 transition hover:bg-seal-400 sm:w-auto sm:px-8"
            >
              第一話から読む
            </a>
          )}
          <a
            id="continue-reading"
            href={base}
            hidden
            class="inline-flex w-full justify-center rounded-sm border border-gilt-400/70 bg-paper-50/55 px-6 py-3 text-sm tracking-[0.08em] text-tide-700 backdrop-blur-[2px] transition hover:border-gilt-500 hover:text-gilt-600 sm:w-auto sm:px-8"
          >
            つづきから読む
          </a>
          <a
            href="#chapters"
            class="inline-flex w-full justify-center rounded-sm border border-gilt-400/70 bg-paper-50/55 px-6 py-3 text-xs tracking-[0.08em] text-tide-700 backdrop-blur-[2px] transition hover:border-gilt-500 hover:text-gilt-600 sm:w-auto sm:px-8"
          >
            もくじへ
          </a>
        </div>
        <p class="hero-halo mt-4 text-xs tracking-[0.12em] text-ink-600">
          全{chapters.length}話公開中 ・ 連載中
        </p>
      </div>
    </div>
  </section>

  <!-- ファーストビュー直下に、迷わず読書へ戻れる短い導線を置く -->
  <nav class="mx-auto max-w-3xl px-4 pt-4 sm:px-6 sm:pt-6" aria-label="読書への近道">
    <div class="sheet grid grid-cols-3 divide-x divide-gilt-400/25 overflow-hidden">
      {first && (
        <a href={`${base}chapter/${first.slug}`} class="group px-2 py-3 text-center transition hover:bg-tide-500/5 sm:px-4 sm:py-4">
          <span class="block text-[10px] tracking-[0.08em] text-ink-600">はじめから</span>
          <span class="mt-1 block font-display text-sm text-tide-900 transition group-hover:text-seal-600">第1話</span>
        </a>
      )}
      {latest && (
        <a href={`${base}chapter/${latest.slug}`} class="group px-2 py-3 text-center transition hover:bg-tide-500/5 sm:px-4 sm:py-4">
          <span class="block text-[10px] tracking-[0.08em] text-ink-600">最新話を読む</span>
          <span class="mt-1 block font-display text-sm text-tide-900 transition group-hover:text-seal-600">第{latest.number}話</span>
        </a>
      )}
      <a href="#chapters" class="group px-2 py-3 text-center transition hover:bg-tide-500/5 sm:px-4 sm:py-4">
        <span class="block text-[10px] tracking-[0.08em] text-ink-600">話を選ぶ</span>
        <span class="mt-1 block font-display text-sm text-tide-900 transition group-hover:text-seal-600">もくじ</span>
      </a>
    </div>
  </nav>

  <section class="mx-auto max-w-3xl px-6 pt-10 md:pt-16" aria-labelledby="story-preview-heading">
    <a href={`${base}story`} class="sheet sheet-lift group grid overflow-hidden sm:grid-cols-[42%_1fr] hover:-translate-y-0.5">
      <img src={heroSrc} alt="" width="1672" height="941" loading="lazy" class="h-full min-h-44 w-full object-cover" />
      <div class="px-6 py-7 md:px-8">
        <p class="font-eyebrow text-xs tracking-[0.35em] text-gilt-600">STORY</p>
        <h2 id="story-preview-heading" class="mt-2 font-display text-2xl font-bold text-tide-900">戦えない。<br />だから、人を動かす。</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-600">ネタバレなしのあらすじと、第1巻の章紹介へ。</p>
        <span class="mt-4 inline-block text-xs tracking-[0.06em] text-seal-600">あらすじを読む ▶</span>
      </div>
    </a>
  </section>

  <section class="mx-auto max-w-3xl px-6 pt-5">
    <a href={`${base}movie`} class="sheet sheet-lift group flex items-center gap-5 overflow-hidden p-3 hover:-translate-y-0.5">
      <img src={`${base}movie/teaser-01-poster.jpg`} alt="" width="720" height="720" loading="lazy" class="h-24 w-24 shrink-0 rounded-sm object-cover sm:h-28 sm:w-28" />
      <div class="min-w-0 py-2">
        <p class="font-eyebrow text-xs tracking-[0.35em] text-gilt-600">MOVIE</p>
        <h2 class="mt-1 font-display text-xl font-bold text-tide-900">ティザー映像</h2>
        <p class="mt-2 text-xs leading-relaxed text-ink-600">音と動きで覗く、ハイベルのひとかけら。</p>
      </div>
      <span class="ml-auto shrink-0 pr-3 text-seal-500" aria-hidden="true">▶</span>
    </a>
  </section>

  <section id="news" class="mx-auto max-w-3xl px-6 pt-14 md:pt-20" aria-labelledby="news-heading">
    <div class="flex items-end justify-between gap-4 border-b border-gilt-400/30 pb-3">
      <div>
        <p class="font-eyebrow text-xs tracking-[0.4em] text-gilt-600">NEWS</p>
        <h2 id="news-heading" class="mt-1 font-display text-2xl font-bold text-tide-900">更新情報</h2>
      </div>
      <a href={`${base}news`} class="text-xs tracking-[0.06em] text-tide-700 hover:text-gilt-600">すべて見る ▶</a>
    </div>
    <ol class="divide-y divide-gilt-400/20">
      {NEWS.slice(0, 3).map((item) => (
        <li>
          <a href={`${base}news/#${item.id}`} class="group grid gap-1 py-4 sm:grid-cols-[7.5rem_1fr] sm:items-baseline">
            <time datetime={item.date} class="font-eyebrow text-[11px] tracking-[0.14em] text-gilt-600">{displayDate(item.date)}</time>
            <span class="font-display text-sm leading-relaxed text-tide-900 transition group-hover:text-seal-600">{item.title}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="mx-auto max-w-3xl px-6 pt-16" aria-labelledby="novel-heading">
    <div class="sheet grid items-center gap-8 overflow-hidden px-6 py-8 sm:grid-cols-[13rem_1fr] md:px-9 md:py-10">
      <picture class="mx-auto">
        <source srcset={`${base}cover.avif`} type="image/avif" />
        <img src={coverSrc} alt="WEB小説第1巻表紙" width="600" height="600" loading="lazy" class="w-48 rounded-sm shadow-xl shadow-tide-900/25 ring-1 ring-gilt-400/50 sm:w-52" />
      </picture>
      <div>
        <p class="font-eyebrow text-xs tracking-[0.35em] text-gilt-600">WEB NOVEL / VOLUME I</p>
        <h2 id="novel-heading" class="mt-2 font-display text-3xl font-bold leading-snug text-tide-900">2度目の転生は<br />女遊び人でした</h2>
        <p class="mt-3 text-xs tracking-[0.12em] text-ink-600">原作・執筆：chapinosuke 　全{chapters.length}話</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {['異世界転生', 'お色気コメディ', '女主人公', 'お仕事', '冒険'].map((tag) => (
            <span class="rounded-full border border-gilt-400/35 bg-paper-50 px-3 py-1 text-[11px] text-ink-600">{tag}</span>
          ))}
        </div>
        <p class="mt-5 text-sm leading-loose text-ink-700">二度目の転生で授かったのは、戦闘力ではなく「女遊び人」の職業。最弱装備から始まる、賢者を目指す異世界お色気コメディ。</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={`${base}chapter/${first?.slug}`} class="rounded-sm bg-seal-500 px-6 py-3 text-xs tracking-[0.06em] text-paper-50 transition hover:bg-seal-400">第一話から読む</a>
          <a href="#chapters" class="rounded-sm border border-tide-500/50 px-6 py-3 text-xs tracking-[0.06em] text-tide-700">もくじへ</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTERS：章（アーク）ごとに畳めるもくじ -->
  <section id="chapters" class="mx-auto max-w-3xl scroll-mt-8 px-6 pb-20 pt-16 md:pb-24 md:pt-24">
    <div class="flex items-center gap-5">
      <div class="tide-rule h-px flex-1 opacity-40" aria-hidden="true"></div>
      <h2 class="font-eyebrow text-sm tracking-[0.5em] text-gilt-600">CONTENTS</h2>
      <div class="tide-rule h-px flex-1 opacity-40" aria-hidden="true"></div>
    </div>
    <p class="mt-2 text-center text-xs tracking-[0.3em] text-ink-600">もくじ</p>
    <p class="mt-2 text-center text-[11px] tracking-[0.12em] text-ink-600">
      ――灰鷲ギルド　ハイベル支部　掲示板より
    </p>

    <div class="mt-10 space-y-4">
      {arcs.map((group, gi) => (
        <details
          class="arc"
          data-from={group.arc.from}
          data-to={group.arc.to}
          open={gi === 0}
        >
          <summary class="sheet sheet-lift flex cursor-pointer items-center gap-4 px-5 py-4 hover:-translate-y-0.5">
            <span class="hanko stamp-in shrink-0 text-[10px]" aria-hidden="true">
              {`${group.arc.no}之章`}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block truncate font-display text-lg text-tide-900 md:text-xl">
                {group.arc.title}
              </span>
              <span class="mt-0.5 block text-xs text-ink-600">
                {`第${toKanji(group.items[0].number)}〜${toKanji(group.items[group.items.length - 1].number)}話`}
              </span>
            </span>
            <span class="arc-marker shrink-0 font-eyebrow text-sm text-tide-500" aria-hidden="true">▽</span>
          </summary>

          <ol class="mt-1 pl-1">
            {group.items.map((c, ci) => (
              <li class="border-b border-gilt-400/15 last:border-b-0">
                <a
                  href={`${base}chapter/${c.slug}`}
                  data-chapter-link={c.slug}
                  class="group flex items-center gap-4 py-3 transition duration-200"
                >
                  <span
                    class="hanko stamp-in shrink-0 text-[10px]"
                    style={`animation-delay: ${ci * 70}ms`}
                    aria-hidden="true"
                  >
                    {`第${toKanji(c.number)}話`}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="sr-only">{`第${c.number}話　`}</span>
                    <span class="block truncate font-display text-lg font-medium text-tide-900 transition duration-200 group-hover:text-seal-600 md:text-xl">
                      {stripChapterPrefix(c.titleLine)}
                    </span>
                  </span>
                  <span data-read-badge hidden class="shrink-0 rounded-full bg-tide-500/10 px-2 py-1 text-[11px] tracking-[0.1em] text-tide-700">読了</span>
                </a>
              </li>
            ))}
          </ol>
        </details>
      ))}
    </div>

    {chapters.length === 0 && (
      <p class="mt-10 text-center font-eyebrow text-sm tracking-widest text-ink-600">
        まだ話がありません。第一話の掲示をお待ちください。
      </p>
    )}
  </section>

  <!-- 読書導線の後に、設定資料への入口を置く -->
  <nav class="mx-auto max-w-3xl px-6 pb-28" aria-label="資料への入口">
    <p class="mb-5 text-center text-xs tracking-[0.2em] text-ink-600">物語の資料</p>
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
      {[
        { href: `${base}characters`, en: 'CHARACTERS', ja: '人物', sub: '常連台帳' },
        { href: `${base}world`, en: 'WORLD', ja: '世界観', sub: '資料室蔵' },
        { href: `${base}ledger`, en: 'LEDGER', ja: '帳簿', sub: '換算と罰金' },
        { href: `${base}gallery`, en: 'GALLERY', ja: '画廊', sub: '一枚絵' },
      ].map((item) => (
        <li>
          <a
            href={item.href}
            class="sheet sheet-lift group flex flex-col items-center gap-0.5 px-3 py-4 text-center hover:-translate-y-0.5"
          >
            <span class="font-eyebrow text-[11px] tracking-[0.3em] text-gilt-600 transition group-hover:text-seal-600">
              {item.en}
            </span>
            <span class="font-display text-base text-tide-900 md:text-lg">{item.ja}</span>
            <span class="mt-0.5 text-[11px] tracking-[0.18em] text-ink-600">{item.sub}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- 「つづきから読む」：last-read がある場合のみ表示 -->
  <script is:inline define:vars={{ base }}>
    (function () {
      try {
        var raw = localStorage.getItem('last-read');
        if (!raw) return;
        var data = JSON.parse(raw);
        if (!data || !data.slug) return;
        var el = document.getElementById('continue-reading');
        if (el) {
          el.setAttribute('href', base + 'chapter/' + data.slug + '?resume=1');
          el.hidden = false;
        }
        var start = document.getElementById('start-reading');
        if (start) start.hidden = true;
        // つづきから読む話を含む章（アーク）も初期状態で開く（先頭章に加えて）
        var num = typeof data.number === 'number' ? data.number : parseInt(data.slug, 10);
        if (!isNaN(num)) {
          var arcs = document.querySelectorAll('#chapters details.arc');
          for (var i = 0; i < arcs.length; i++) {
            var from = parseInt(arcs[i].getAttribute('data-from'), 10);
            var to = parseInt(arcs[i].getAttribute('data-to'), 10);
            if (num >= from && num <= to) {
              arcs[i].open = true;
              break;
            }
          }
        }
      } catch (e) {}
    })();
  </script>

  <script is:inline>
    (function () {
      try {
        var read = JSON.parse(localStorage.getItem('read-chapters') || '[]');
        if (!Array.isArray(read)) return;
        for (var i = 0; i < read.length; i++) {
          var link = document.querySelector('[data-chapter-link="' + read[i] + '"]');
          if (!link) continue;
          var badge = link.querySelector('[data-read-badge]');
          if (badge) badge.hidden = false;
        }
      } catch (e) {}
    })();
  </script>
</Base>
