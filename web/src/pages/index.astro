---
import Base from '../layouts/Base.astro';
import { getChapters, groupByArc, toKanji, stripChapterPrefix } from '../lib/chapters';

const chapters = await getChapters();
const first = chapters[0];
const latest = chapters.at(-1);
const arcs = groupByArc(chapters);
const base = import.meta.env.BASE_URL;
const coverSrc = `${base}cover.png`;
const homeUrl = Astro.site ? new URL(base, Astro.site).toString() : base;
const siteDescription = '戦えない。魔法も使えない。装備はバニーガール衣装のみ。灰鷲ギルドの昼の書類から、陽気な冒険者の夜の話を——異世界転生コメディ、連載中。';
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '2度目の転生は女遊び人でした',
  url: homeUrl,
  description: siteDescription,
  inLanguage: 'ja',
};
---

<Base
  title="2度目の転生は女遊び人でした"
  description={siteDescription}
  structuredData={websiteSchema}
>
  <!-- HERO：酒場の熱を通しつつ、紙面の書類世界へ着地する -->
  <section class="relative overflow-hidden">
    <!-- 背景：世界観のPVをループ再生。reduced-motion時はポスター静止画にフォールバック -->
    <div
      class="pointer-events-none absolute inset-0 z-0 bg-cover bg-center"
      style={`background-image:url('${base}hero-poster.webp')`}
      aria-hidden="true"
    >
    </div>
    <video
      class="pointer-events-none absolute inset-0 z-0 hidden h-full w-full object-cover md:block motion-reduce:hidden"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={`${base}hero-poster.webp`}
      aria-hidden="true"
    >
      <source src={`${base}hero-bg.mp4`} type="video/mp4" media="(min-width: 768px)" />
    </video>
    <!-- 紙ウォッシュ＋古金の暖色光：映像の熱を残しつつ下端で紙面へ -->
    <div class="hero-wash pointer-events-none absolute inset-0 z-0" aria-hidden="true"></div>
    <!-- 印刷網点：動画を紙面デザインに馴染ませる -->
    <div class="hero-dots pointer-events-none absolute inset-0 z-0" aria-hidden="true"></div>
    <div class="tide-rule absolute inset-x-0 top-0 z-10 h-[3px]" aria-hidden="true"></div>
    <div
      class="relative z-10 mx-auto flex max-w-5xl flex-col items-center gap-12 px-6 pt-16 pb-28 md:flex-row md:gap-16 md:pt-28 md:pb-40"
    >
      <div class="relative shrink-0 fade-in">
        <div class="cover-glow absolute -inset-12 blur-3xl" aria-hidden="true"></div>
        <picture>
          <source srcset={`${base}cover.avif`} type="image/avif" />
          <img
            src={coverSrc}
            alt="表紙：酒場に立つバニーガール姿のミア"
            width="600"
            height="600"
            fetchpriority="high"
            class="relative w-64 rounded-sm shadow-2xl shadow-tide-900/35 ring-1 ring-gilt-400/70 md:w-80"
          />
        </picture>
      </div>

      <div class="text-center md:text-left fade-in" style="animation-delay: 0.12s">
        <p class="hero-halo font-eyebrow text-xs tracking-[0.35em] text-gilt-600">
          TRANSMIGRATION COMEDY
        </p>
        <p class="hero-halo mt-1 text-xs tracking-[0.3em] text-ink-500">異世界転生コメディ・連載中</p>
        <h1
          class="hero-halo mt-5 font-display text-4xl font-bold leading-snug text-tide-900 md:text-5xl md:leading-snug"
        >
          2度目の転生は<br />女遊び人でした
        </h1>
        <p class="hero-halo mt-6 max-w-md text-sm leading-loose text-ink-700 md:text-base">
          戦えない。魔法も使えない。装備はバニーガール衣装のみ。<br />
          そんな最底辺から、機転と人心掌握だけで「賢者」を目指す。
        </p>
        <!-- 二層の意図：昼の書類 × 夜の酒場 -->
        <p
          class="hero-halo mt-4 max-w-md text-xs leading-relaxed tracking-[0.06em] text-tide-700 md:text-sm"
        >
          灰鷲ギルドの昼の書類から、<br class="sm:hidden" />陽気な冒険者の夜の話を——。
        </p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-4 md:justify-start">
          {first && (
            <a
              href={`${base}chapter/${first.slug}`}
              class="rounded-sm bg-seal-500 px-8 py-3 text-sm tracking-[0.2em] text-paper-50 shadow-lg shadow-seal-600/30 ring-1 ring-seal-400/40 transition hover:bg-seal-400"
            >
              第一話から読む
            </a>
          )}
          {latest && latest.slug !== first?.slug && (
            <a
              href={`${base}chapter/${latest.slug}`}
              class="rounded-sm border border-seal-500/70 bg-paper-50/65 px-8 py-3 text-sm tracking-[0.14em] text-seal-600 backdrop-blur-[2px] transition hover:bg-paper-50 hover:text-seal-500"
            >
              最新話を読む
            </a>
          )}
          <a
            id="continue-reading"
            href={base}
            hidden
            class="rounded-sm border border-gilt-400/70 bg-paper-50/55 px-8 py-3 text-sm tracking-[0.2em] text-tide-700 backdrop-blur-[2px] transition hover:border-gilt-500 hover:text-gilt-600"
          >
            つづきから読む
          </a>
          <a
            href="#chapters"
            class="rounded-sm border border-gilt-400/70 bg-paper-50/55 px-8 py-3 font-eyebrow text-xs tracking-[0.3em] text-tide-700 backdrop-blur-[2px] transition hover:border-gilt-500 hover:text-gilt-600"
          >
            もくじへ
          </a>
        </div>
        <p class="hero-halo mt-4 text-xs tracking-[0.12em] text-ink-600">
          全{chapters.length}話公開中 ・ 連載中
        </p>
      </div>
    </div>
  </section>

  <!-- CHAPTERS：章（アーク）ごとに畳めるもくじ -->
  <section id="chapters" class="mx-auto max-w-3xl scroll-mt-8 px-6 pb-20 pt-16 md:pb-24 md:pt-24">
    <div class="flex items-center gap-5">
      <div class="tide-rule h-px flex-1 opacity-40" aria-hidden="true"></div>
      <h2 class="font-eyebrow text-sm tracking-[0.5em] text-gilt-500">CONTENTS</h2>
      <div class="tide-rule h-px flex-1 opacity-40" aria-hidden="true"></div>
    </div>
    <p class="mt-2 text-center text-xs tracking-[0.3em] text-ink-500">もくじ</p>
    <p class="mt-2 text-center text-[11px] tracking-[0.12em] text-ink-500">
      ――灰鷲ギルド　ハイベル支部　掲示板より
    </p>

    <div class="mt-10 space-y-4">
      {arcs.map((group, gi) => (
        <details
          class="arc"
          data-from={group.arc.from}
          data-to={group.arc.to}
          open={gi === 0}
        >
          <summary class="sheet sheet-lift flex cursor-pointer items-center gap-4 px-5 py-4 hover:-translate-y-0.5">
            <span class="hanko stamp-in shrink-0 text-[10px]" aria-hidden="true">
              {`${group.arc.no}之章`}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block truncate font-display text-lg text-tide-900 md:text-xl">
                {group.arc.title}
              </span>
              <span class="mt-0.5 block text-xs text-ink-500">
                {`第${toKanji(group.items[0].number)}〜${toKanji(group.items[group.items.length - 1].number)}話`}
              </span>
            </span>
            <span class="arc-marker shrink-0 font-eyebrow text-sm text-tide-500" aria-hidden="true">▽</span>
          </summary>

          <ol class="mt-1 pl-1">
            {group.items.map((c, ci) => (
              <li class="border-b border-gilt-400/15 last:border-b-0">
                <a
                  href={`${base}chapter/${c.slug}`}
                  class="group flex items-center gap-4 py-3 transition duration-200"
                >
                  <span
                    class="hanko stamp-in shrink-0 text-[10px]"
                    style={`animation-delay: ${ci * 70}ms`}
                    aria-hidden="true"
                  >
                    {`第${toKanji(c.number)}話`}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="sr-only">{`第${c.number}話　`}</span>
                    <span class="block truncate font-display text-lg font-medium text-tide-900 transition duration-200 group-hover:text-seal-600 md:text-xl">
                      {stripChapterPrefix(c.titleLine)}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </details>
      ))}
    </div>

    {chapters.length === 0 && (
      <p class="mt-10 text-center font-eyebrow text-sm tracking-widest text-ink-500">
        まだ話がありません。第一話の掲示をお待ちください。
      </p>
    )}
  </section>

  <!-- 読書導線の後に、設定資料への入口を置く -->
  <nav class="mx-auto max-w-3xl px-6 pb-28" aria-label="資料への入口">
    <p class="mb-5 text-center text-xs tracking-[0.2em] text-ink-500">物語の資料</p>
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
      {[
        { href: `${base}characters`, en: 'CHARACTERS', ja: '人物', sub: '常連台帳' },
        { href: `${base}world`, en: 'WORLD', ja: '世界観', sub: '資料室蔵' },
        { href: `${base}ledger`, en: 'LEDGER', ja: '帳簿', sub: '換算と罰金' },
        { href: `${base}gallery`, en: 'GALLERY', ja: '画廊', sub: '一枚絵' },
      ].map((item) => (
        <li>
          <a
            href={item.href}
            class="sheet sheet-lift group flex flex-col items-center gap-0.5 px-3 py-4 text-center hover:-translate-y-0.5"
          >
            <span class="font-eyebrow text-[10px] tracking-[0.3em] text-gilt-500 transition group-hover:text-gilt-600">
              {item.en}
            </span>
            <span class="font-display text-base text-tide-900 md:text-lg">{item.ja}</span>
            <span class="mt-0.5 text-[10px] tracking-[0.18em] text-ink-500">{item.sub}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- 「つづきから読む」：last-read がある場合のみ表示 -->
  <script is:inline define:vars={{ base }}>
    (function () {
      try {
        var raw = localStorage.getItem('last-read');
        if (!raw) return;
        var data = JSON.parse(raw);
        if (!data || !data.slug) return;
        var el = document.getElementById('continue-reading');
        if (el) {
          el.setAttribute('href', base + 'chapter/' + data.slug + '?resume=1');
          el.hidden = false;
        }
        // つづきから読む話を含む章（アーク）も初期状態で開く（先頭章に加えて）
        var num = typeof data.number === 'number' ? data.number : parseInt(data.slug, 10);
        if (!isNaN(num)) {
          var arcs = document.querySelectorAll('#chapters details.arc');
          for (var i = 0; i < arcs.length; i++) {
            var from = parseInt(arcs[i].getAttribute('data-from'), 10);
            var to = parseInt(arcs[i].getAttribute('data-to'), 10);
            if (num >= from && num <= to) {
              arcs[i].open = true;
              break;
            }
          }
        }
      } catch (e) {}
    })();
  </script>
</Base>
