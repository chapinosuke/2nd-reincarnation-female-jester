---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getChapters, neighbors, toKanji, stripChapterPrefix } from '../../lib/chapters';

export async function getStaticPaths() {
  const chapters = await getChapters();
  return chapters.map((c) => ({
    params: { slug: c.slug },
    props: { current: c, chapters },
  }));
}

const { current, chapters } = Astro.props;
const { Content } = await render(current.entry);
const { prev, next } = neighbors(chapters, current);
const title = stripChapterPrefix(current.titleLine);
---

<Base title={`${current.titleLine} ｜ 2度目の転生は女遊び人でした`}>
  <!-- 上部ナビ -->
  <header class="sticky top-0 z-30 border-b border-gilt-400/25 bg-paper-50/90 backdrop-blur-md">
    <div class="tide-rule absolute inset-x-0 top-0 h-[2px]" aria-hidden="true"></div>
    <div class="mx-auto flex max-w-3xl items-center justify-between px-5 py-3.5">
      <a
        href="/"
        class="font-eyebrow text-xs tracking-[0.25em] text-tide-700 transition hover:text-gilt-600"
      >
        ◀ もくじ
      </a>
      <span class="font-eyebrow text-xs tracking-[0.35em] text-gilt-600">
        第{current.number}話
      </span>
      <span class="w-14" aria-hidden="true"></span>
    </div>
  </header>

  <!-- 本文：一枚の書類として読む -->
  <article class="sheet fade-in mx-auto my-10 max-w-[46rem] px-6 py-12 md:my-14 md:px-14 md:py-16">
    <div class="text-center">
      <span class="hanko text-base md:text-lg" aria-hidden="true">
        {`第${toKanji(current.number)}話`}
      </span>
      <h1 class="mt-8 font-display text-2xl font-bold leading-relaxed text-tide-900 md:text-3xl">
        <span class="sr-only">{`第${current.number}話　`}</span>{title}
      </h1>
      {current.subtitleLine && (
        <p class="mt-3 text-sm text-ink-600">{current.subtitleLine}</p>
      )}
      <div class="mx-auto mt-8 flex max-w-xs items-center gap-4" aria-hidden="true">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent to-gilt-400/50"></div>
        <span class="text-xs text-seal-500">◆</span>
        <div class="h-px flex-1 bg-gradient-to-l from-transparent to-gilt-400/50"></div>
      </div>
    </div>

    <div class="prose prose-lg chapter-body mt-10">
      <Content />
    </div>
  </article>

  <!-- 章ナビゲーション -->
  <nav class="mx-auto max-w-[46rem] px-6 pb-16">
    <div class="grid grid-cols-2 gap-4">
      <div>
        {prev && (
          <a
            href={`/chapter/${prev.slug}`}
            class="sheet group block px-5 py-4 transition duration-200 hover:-translate-y-0.5"
          >
            <p class="font-eyebrow text-[10px] tracking-[0.3em] text-ink-600">◀ まえのはなし</p>
            <p class="mt-2 truncate font-display text-sm text-tide-900 group-hover:text-seal-600">
              第{prev.number}話　{stripChapterPrefix(prev.titleLine)}
            </p>
          </a>
        )}
      </div>
      <div>
        {next && (
          <a
            href={`/chapter/${next.slug}`}
            class="sheet group block px-5 py-4 text-right transition duration-200 hover:-translate-y-0.5"
          >
            <p class="font-eyebrow text-[10px] tracking-[0.3em] text-ink-600">つぎのはなし ▶</p>
            <p class="mt-2 truncate font-display text-sm text-tide-900 group-hover:text-seal-600">
              第{next.number}話　{stripChapterPrefix(next.titleLine)}
            </p>
          </a>
        )}
      </div>
    </div>

    <div class="mt-12 text-center">
      <a
        href="/"
        class="inline-block rounded-sm border border-tide-500/60 px-8 py-3 font-eyebrow text-xs tracking-[0.3em] text-tide-700 transition hover:border-gilt-400 hover:text-gilt-600"
      >
        もくじにもどる
      </a>
    </div>
  </nav>
</Base>
