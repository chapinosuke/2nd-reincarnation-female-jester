---
import Base from '../layouts/Base.astro';
import PageNav from '../components/PageNav.astro';
import ExploreNext from '../components/ExploreNext.astro';
import { SITE_TITLE } from '../lib/site';

const base = import.meta.env.BASE_URL;
const movies = [
  { no: '01', src: `${base}movie/teaser-01.mp4`, poster: `${base}movie/teaser-01-poster.jpg`, title: 'ミア、二度目の朝' },
  { no: '02', src: `${base}movie/teaser-02.mp4`, poster: `${base}movie/teaser-02-poster.jpg`, title: '陽気な冒険者たち' },
];
---

<Base title={`MOVIE ｜ ${SITE_TITLE}`} description="異世界お色気コメディ『2度目の転生は女遊び人でした』ティザー映像。">
  <PageNav label="MOVIE" />
  <main class="mx-auto max-w-4xl px-6 pb-24 pt-14 md:pt-20">
    <header class="fade-in text-center">
      <p class="font-eyebrow text-sm tracking-[0.5em] text-gilt-600">MOVIE</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-tide-900 md:text-5xl">映像</h1>
      <p class="mt-4 text-sm text-ink-600">――酒場の熱と、旅の気配をひとかけら</p>
    </header>

    <section class="mt-12 grid gap-8 sm:grid-cols-2" aria-label="ティザー映像">
      {movies.map((movie) => (
        <article class="sheet overflow-hidden p-3 md:p-4">
          <video controls playsinline preload="metadata" poster={movie.poster} class="aspect-square w-full rounded-sm bg-tide-900" aria-label={movie.title}>
            <source src={movie.src} type="video/mp4" />
            ご利用のブラウザは動画の再生に対応していません。
          </video>
          <div class="px-2 pb-2 pt-4">
            <p class="font-eyebrow text-[11px] tracking-[0.3em] text-gilt-600">TEASER CUT {movie.no}</p>
            <h2 class="mt-1 font-display text-lg font-bold text-tide-900">{movie.title}</h2>
          </div>
        </article>
      ))}
    </section>

    <p class="mt-8 text-center text-xs leading-relaxed text-ink-600">再生時に音声が流れます。音量にご注意ください。</p>
    <div class="mt-12 text-center">
      <a href={`${base}chapter/01`} class="inline-block rounded-sm bg-seal-500 px-9 py-3.5 text-sm tracking-[0.18em] text-paper-50 transition hover:bg-seal-400">物語のはじまりを読む</a>
    </div>
    <ExploreNext current="movie" />
  </main>
</Base>
