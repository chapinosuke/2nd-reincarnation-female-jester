---
import Base from '../layouts/Base.astro';
import PageNav from '../components/PageNav.astro';
import PageHeading from '../components/PageHeading.astro';
import ExploreNext from '../components/ExploreNext.astro';
import { displayDate, NEWS, SITE_TITLE } from '../lib/site';

const base = import.meta.env.BASE_URL;
---

<Base title={`NEWS ｜ ${SITE_TITLE}`} description="本編の公開、読書機能、作品資料の更新情報。">
  <PageNav label="NEWS" />
  <main id="page-content" class="mx-auto max-w-3xl px-6 pb-24 pt-14 md:pt-20">
    <PageHeading eyebrow="NEWS" title="おしらせ" description="本編と作品資料の更新情報" />
    <section class="mt-12 space-y-4" aria-label="更新履歴">
      {NEWS.map((item) => (
        <article id={item.id} class="sheet px-6 py-6 md:px-8">
          <time datetime={item.date} class="font-eyebrow text-xs tracking-[0.18em] text-gilt-600">{displayDate(item.date)}</time>
          <h2 class="mt-2 font-display text-xl font-bold leading-relaxed text-tide-900">{item.title}</h2>
          <p class="mt-3 text-sm leading-loose text-ink-700">{item.body}</p>
        </article>
      ))}
    </section>
    <div class="mt-8">
      <a href={`${base}rss.xml`} class="inline-block rounded-sm border border-gilt-400/50 px-5 py-2 text-xs tracking-[0.12em] text-gilt-600 transition hover:border-tide-500 hover:text-tide-700">RSSで更新を受け取る</a>
    </div>
    <ExploreNext current="news" />
  </main>
</Base>
