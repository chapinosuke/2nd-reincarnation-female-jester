---
import Base from '../layouts/Base.astro';
import PageNav from '../components/PageNav.astro';
import { displayDate, NEWS, REPOSITORY_URL, SITE_AUTHOR, SITE_TITLE } from '../lib/site';

const base = import.meta.env.BASE_URL;
---

<Base title={`NEWS ｜ ${SITE_TITLE}`} description="本編の公開、読書機能、作品資料の更新情報。">
  <PageNav label="NEWS" />
  <main class="mx-auto max-w-3xl px-6 pb-24 pt-14 md:pt-20">
    <header class="fade-in text-center">
      <p class="font-eyebrow text-sm tracking-[0.5em] text-gilt-500">NEWS</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-tide-900 md:text-5xl">更新情報</h1>
      <p class="mt-4 text-sm text-ink-600">――灰鷲ギルド　掲示板より</p>
    </header>
    <section class="mt-12 space-y-4" aria-label="更新履歴">
      {NEWS.map((item) => (
        <article id={item.id} class="sheet px-6 py-6 md:px-8">
          <time datetime={item.date} class="font-eyebrow text-xs tracking-[0.18em] text-gilt-600">{displayDate(item.date)}</time>
          <h2 class="mt-2 font-display text-xl font-bold leading-relaxed text-tide-900">{item.title}</h2>
          <p class="mt-3 text-sm leading-loose text-ink-700">{item.body}</p>
        </article>
      ))}
    </section>
    <section class="sheet mt-12 px-6 py-8 md:px-9" aria-labelledby="author-heading">
      <p class="font-eyebrow text-xs tracking-[0.35em] text-gilt-500">AUTHOR</p>
      <h2 id="author-heading" class="mt-2 font-display text-2xl font-bold text-tide-900">{SITE_AUTHOR}</h2>
      <p class="mt-4 text-sm leading-loose text-ink-700">『{SITE_TITLE}』の原作・執筆・サイト制作。</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={REPOSITORY_URL} rel="author external" class="rounded-sm border border-tide-500/50 px-5 py-2 text-xs tracking-[0.12em] text-tide-700 transition hover:border-gilt-400 hover:text-gilt-600">GitHub / お問い合わせ</a>
        <a href={`${base}rss.xml`} class="rounded-sm border border-gilt-400/50 px-5 py-2 text-xs tracking-[0.12em] text-gilt-600 transition hover:border-tide-500 hover:text-tide-700">RSSで更新を受け取る</a>
      </div>
    </section>
  </main>
</Base>
