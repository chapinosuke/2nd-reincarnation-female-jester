---
interface Props {
  character: string;
  label?: string;
}
const { character, label = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
// Square crops in the 1024 × 1536 source images, aligned by eye line and face size.
// Source coordinates keep the framing identical at every icon size.
const crops: Record<string, { x: number; y: number; size: number }> = {
  mia: { x: 354, y: 96, size: 300 },
  alto: { x: 338, y: 25, size: 300 },
  sera: { x: 358, y: 61, size: 300 },
  gold: { x: 323, y: -14, size: 350 },
};
const crop = crops[character] ?? crops.mia;
const framing = `--portrait-width:${1024 / crop.size * 100}%;--portrait-left:${-crop.x / crop.size * 100}%;--portrait-top:${-crop.y / crop.size * 100}%`;
---
<span class="portrait-window" style={framing}>
  <img src={`${base}characters/standees/${character}-v1.webp`} alt={label} width="1024" height="1536" loading="lazy" />
</span>
<style>
  .portrait-window { display: block; position: relative; width: 100%; height: 100%; overflow: hidden; }
  .portrait-window img { position: absolute; width: var(--portrait-width); max-width: none; height: auto; left: var(--portrait-left); top: var(--portrait-top); }
</style>
